{
  "name": "osaphla-language-academy",
  "private": true,
  "version": "1.0.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:local": "node scripts/start-local.mjs",
    "build": "npm run curriculum:build && npm run curriculum:validate && tsc -b && vite build",
    "preview": "vite preview",
    "curriculum:build": "node scripts/build-curriculum.mjs",
    "curriculum:validate": "node scripts/validate-curriculum.mjs",
    "themes:validate": "node scripts/validate-themes.mjs",
    "bilingual:validate": "node scripts/validate-bilingual.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa": "npm run build && npm run themes:validate && npm run bilingual:validate && npm test && npm run test:e2e",
    "render:media": "node scripts/render-media.mjs",
    "media:validate": "node scripts/validate-media.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.2",
    "dexie": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
